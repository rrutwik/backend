{
  "name": "backend",
  "version": "1.0.0",
  "description": "API Server",
  "author": "TechKarmic Ventures",
  "license": "ISC",
  "scripts": {
    "start": "npm run build && cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "swc src -d dist --source-maps --copy-files --strip-leading-paths",
    "build:tsc": "tsc && tsc-alias",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint --ignore-path .gitignore --ext .ts src/",
    "lint:fix": "npm run lint -- --fix",
    "deploy": "npm run build && pm2 start ecosystem.config.js",
    "stop": "pm2 stop backend",
    "restart": "npm run build && pm2 reload backend --update-env"
  },
  "dependencies": {
    "@langchain/core": "1.1.48",
    "@langchain/openai": "1.4.7",
    "@socket.io/redis-adapter": "8.3.0",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.21",
    "axios": "1.16.1",
    "bcrypt": "6.0.0",
    "bullmq": "5.7.8",
    "chess.js": "^1.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "envalid": "7.3.1",
    "express": "4.22.2",
    "googleapis": "131.0.0",
    "helmet": "5.1.1",
    "hpp": "0.2.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.17.23",
    "lru-cache": "11.1.0",
    "moment-timezone": "0.6.0",
    "mongoose": "8.9.5",
    "morgan": "1.10.1",
    "razorpay": "2.9.6",
    "reflect-metadata": "0.1.13",
    "socket.io": "4.8.3",
    "swagger-ui-express": "4.5.0",
    "typedi": "0.10.0",
    "uuid": "14.0.0",
    "winston": "3.8.1",
    "winston-daily-rotate-file": "4.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.0",
    "@types/compression": "1.7.2",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.12",
    "@types/express": "4.17.21",
    "@types/hpp": "0.2.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.20",
    "@types/lru-cache": "7.10.9",
    "@types/morgan": "1.9.3",
    "@types/node": "17.0.45",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.60.1",
    "cross-env": "7.0.3",
    "eslint": "10.0.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "husky": "8.0.1",
    "lint-staged": "13.0.3",
    "nodemon": "2.0.19",
    "prettier": "2.7.1",
    "ts-node": "10.9.2",
    "tsc-alias": "1.7.0",
    "tsconfig-paths": "4.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "$uuid"
  }
}
